DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Generate with: npx auth secret
AUTH_SECRET=

# Resend API key, used to send magic-link sign-in emails.
AUTH_RESEND_KEY=re_xxxxxxxxxxxx
AUTH_EMAIL_FROM="Makkah Apartment <onboarding@resend.dev>"

# Whoever signs in with this email becomes admin automatically, the first time they sign in.
ADMIN_EMAIL=you@example.com
